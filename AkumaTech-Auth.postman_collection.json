{
  "info": {
    "_postman_id": "e5270c19-48ee-4bdb-93a4-b11e89c106d4",
    "name": "AkumaTech - Autenticacion",
    "description": "Solicitudes locales para registro, inicio de sesion y administracion protegida de usuarios en AkumaTech.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Registrar usuario",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/register",
        "description": "Crea un usuario. Usa un correo nuevo; si ya existe, el backend responde 409 Conflict."
      },
      "response": []
    },
    {
      "name": "Iniciar sesion",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/login",
        "description": "Inicia sesion con testEmail y testPassword y devuelve un JWT. Si la cuenta es administradora, copia el token a adminToken para usar las solicitudes protegidas."
      },
      "response": []
    },
    {
      "name": "Listar usuarios (admin)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "url": "{{baseUrl}}/users",
        "description": "Lista id, username, email y estado activo, incluidos usuarios inactivos. Requiere adminToken de una cuenta promovida manualmente a administradora en PostgreSQL. No devuelve contrasenas."
      },
      "response": []
    },
    {
      "name": "Eliminar usuario",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "url": "{{baseUrl}}/delete/{{testEmail}}",
        "description": "Desactiva al usuario asociado a testEmail; requiere adminToken y no elimina el registro. Usa solo datos de prueba."
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:7778/api/auth",
      "type": "string"
    },
    {
      "key": "testEmail",
      "value": "usuario.prueba@example.com",
      "type": "string"
    },
    {
      "key": "testPassword",
      "value": "Cambiar123!",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string",
      "description": "JWT de una cuenta con admin=true en PostgreSQL."
    }
  ]
}
