{
  "info": {
    "_postman_id": "e5270c19-48ee-4bdb-93a4-b11e89c106d4",
    "name": "AkumaTech - Autenticacion",
    "description": "Solicitudes de registro e inicio de sesion para el backend local de AkumaTech.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Registrar usuario",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/register",
        "description": "Crea un usuario. Usa un correo nuevo; si ya existe, el backend responde 409 Conflict."
      },
      "response": []
    },
    {
      "name": "Iniciar sesion",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/login",
        "description": "Inicia sesion con un usuario registrado y devuelve un JWT."
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:7778/api/auth",
      "type": "string"
    },
    {
      "key": "testEmail",
      "value": "usuario.prueba@example.com",
      "type": "string"
    },
    {
      "key": "testPassword",
      "value": "Cambiar123!",
      "type": "string"
    }
  ]
}
